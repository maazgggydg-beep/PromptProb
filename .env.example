# Copy this file to .env and fill in your values.
# .env is loaded automatically (see config.py) and is gitignored — never commit it.

# --- Provider API keys (only fill in the ones you actually use) ---
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# --- Target model override (the system under test) ---
# Defaults to Groq's llama-3.3-70b-versatile if left blank.
# TARGET_TYPE=openai_compatible
# TARGET_BASE_URL=https://api.groq.com/openai/v1
# TARGET_API_KEY=${GROQ_API_KEY}
# TARGET_MODEL=llama-3.3-70b-versatile

# --- Attacker model override (generates/adapts attack prompts) ---
# Defaults to local Ollama llama3.2:3b if left blank.
# ATTACKER_TYPE=openai_compatible
# ATTACKER_BASE_URL=http://localhost:11434/v1
# ATTACKER_API_KEY=ollama
# ATTACKER_MODEL=llama3.2:3b

# --- Judge model override (scores compliance vs refusal) ---
# Defaults to local Ollama llama3.2:3b if left blank.
# Judge accuracy matters most — prefer at least a 3B-class model.
# JUDGE_TYPE=openai_compatible
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_API_KEY=ollama
# JUDGE_MODEL=llama3.2:3b

# --- Run settings ---
VARIATIONS_PER_STRATEGY=5
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REQUESTS=3
REPORT_DIR=reports
VERBOSE=false
